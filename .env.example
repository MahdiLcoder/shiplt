# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_with_your_signing_secret
SHIPIT_WEBHOOK_SECRET=replace_with_at_least_32_characters_of_random_secret

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
